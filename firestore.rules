rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is user authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Healthcheck / test connection route
    match /test/{docId} {
      allow read, write: if true;
    }

    // Shared Store Settings: Allow read for store name & branding on login screen, authenticated write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Shared Store Catalog: All signed-in accounts read and sync in real-time
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // Shared Store Transactions: Real-time cashier receipts and sales
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // Shared Stock Purchases: Real-time restock expense tracking
    match /stockPurchases/{purchaseId} {
      allow read, write: if isSignedIn();
    }

    // User Accounts: Staff accounts directory
    match /userAccounts/{userId} {
      allow read, write: if isSignedIn();
    }

    // Catch-all deny for unauthenticated access or unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

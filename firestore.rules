rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Healthcheck / test connection route
    match /test/{docId} {
      allow read, write: if true;
    }

    // Shared Store Settings: Store logo, name, taxes, and receipt config
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Shared Store Catalog: Real-time products, prices, and inventory stock
    match /products/{productId} {
      allow read, write: if true;
    }

    // Shared Store Transactions: Real-time cashier receipts and sales
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Shared Stock Purchases: Real-time restock expense tracking
    match /stockPurchases/{purchaseId} {
      allow read, write: if true;
    }

    // User Accounts Directory: Multi-device cashier & admin accounts
    match /userAccounts/{userId} {
      allow read, write: if true;
    }

    // Deny all other unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
